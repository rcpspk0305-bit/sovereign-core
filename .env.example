# Sovereign-Core Environment Configuration

# Server Settings
# NOTE: 0.0.0.0 binds to all network interfaces (recommended for Docker containers).
# For air-gapped local workstation isolation, configure 127.0.0.1.
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Provider & Sovereignty Configuration
# Provider selection: 'ollama' (default) or 'litellm'
LLM_PROVIDER=ollama
# Air-gap enforcement: when true, all external cloud LLMs are strictly blocked server-side
LOCAL_ONLY=true
LLM_MODEL=gemma4:e2b

# Ollama Engine Configuration
# When running on host: http://localhost:11434
# When running backend in Docker pointing to host Ollama: http://host.docker.internal:11434
# When running Ollama inside Docker Compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemma4:e2b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text:latest
LLM_TIMEOUT_SECONDS=120

# LiteLLM Integration (Optional, disabled by default)
ENABLE_LITELLM=false
LITELLM_API_BASE=http://localhost:11434
LITELLM_DEFAULT_MODEL=ollama/gemma4:e2b
# Optional Cloud Provider API Keys (only usable when LOCAL_ONLY=false)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=./data/audit
AUDIT_LOG_FILE=audit.jsonl

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
